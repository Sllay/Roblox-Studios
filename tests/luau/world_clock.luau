--!strict
local C = require("../../games/maps/mapa-principal/game/places/main/src/ReplicatedStorage/RSWorldClock")
local function near(a: number,b: number)
    assert(math.abs(a-b)<0.00001, tostring(a).." != "..tostring(b))
end
near(C.at(0,180,60),6)
near(C.at(90,180,60),12)
near(C.at(180,180,60),18)
near(C.at(210,180,60),0)
near(C.at(240,180,60),6)
near(C.at(480,180,60),6)
near(C.at(15,30,90),12)
near(C.at(75,30,90),0)
near(C.at(120,30,90),6)
assert(not C.valid(0,60))
assert(not C.valid(180,0/0))
assert(not C.valid(math.huge,60))
near(C.daylight(12),1)
near(C.daylight(0),0)
near(C.daylight(6),C.daylight(18))
assert(C.daylight(5)<C.daylight(7))
assert(C.at(179.99,180,60)<18 and C.at(180.01,180,60)>18)
assert(C.at(239.99,180,60)<6 and C.at(240.01,180,60)>6)
print("WORLD_CLOCK 18 assertions passed")
